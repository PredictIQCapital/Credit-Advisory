# Copy this file to .env and fill in the values. .env is never committed.
# Supabase dashboard -> Project Settings -> API (URL and keys) / Database (password).

# https://<project-ref>.supabase.co
SUPABASE_URL=

# Publishable key (sb_publishable_...) or the legacy "anon" key.
# Safe for a browser, but we keep it server-side anyway.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) or the legacy "service_role" key.
# Full access to the project, bypasses row-level security. Server only. Never share it.
SUPABASE_SECRET_KEY=

# The database password you set when creating the project.
SUPABASE_DB_PASSWORD=
